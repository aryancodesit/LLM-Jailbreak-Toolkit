/* ── Global ── */
Screen {
    background: #0a0a0a;
    color: #cccccc;
    overflow-y: auto;
}

Header {
    background: #110000;
    color: #ff3333;
    text-style: bold;
}

Footer {
    background: #110000;
    color: #555555;
}

/* ── Tabs ── */
Tabs {
    background: #111111;
    border-bottom: solid #2a0000;
}

Tab {
    background: #111111;
    color: #555555;
    padding: 0 3;
}

Tab.-active {
    background: #2a0000;
    color: #ff3333;
    text-style: bold;
}

Tab:hover {
    background: #1a0000;
    color: #ff6666;
}

TabbedContent > ContentSwitcher {
    background: #0a0a0a;
    height: 1fr;
}

TabPane {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

/* ── Layout ── */
.panel {
    height: auto;
    border: solid #1e1e1e;
    background: #111111;
    padding: 1 2;
    margin: 0 0 1 0;
}

.section-title {
    color: #ff3333;
    text-style: bold;
    padding: 0 0 1 0;
}

.muted {
    color: #555555;
    padding: 0 0 0 1;
}

.btn-row {
    height: auto;
    margin-bottom: 1;
}

/* ── Inputs ── */
Input {
    background: #1a1a1a;
    border: solid #2a2a2a;
    color: #eeeeee;
    margin-bottom: 1;
}

Input:focus {
    border: solid #ff3333;
}

Label {
    color: #888888;
}

/* ── Buttons ── */
Button {
    background: #1a1a1a;
    border: solid #444444;
    color: #cccccc;
    margin: 0 1 0 0;
    min-width: 14;
}

Button:hover {
    background: #2a2a2a;
    color: #ffffff;
}

Button:disabled {
    background: #111111;
    border: solid #222222;
    color: #333333;
}

Button.-error {
    background: #1a0000;
    border: solid #ff3333;
    color: #ff3333;
}

Button.-error:hover {
    background: #ff3333;
    color: #000000;
}

Button.-warning {
    background: #1a1000;
    border: solid #ffaa00;
    color: #ffaa00;
}

Button.-warning:hover {
    background: #ffaa00;
    color: #000000;
}

/* ── Checkboxes ── */
Checkbox {
    background: #111111;
    color: #cccccc;
    margin-bottom: 0;
}

Checkbox:hover {
    background: #1a0000;
    color: #ff6666;
}

Checkbox.-on {
    color: #ff3333;
}

/* ── RichLog (Runner output) ── */
RichLog {
    background: #0d0d0d;
    border: solid #1e1e1e;
    padding: 1 2;
    height: 1fr;
    min-height: 12;
    scrollbar-color: #2a2a2a;
}

/* ── Results screen ── */
#table_panel {
    height: 50%;
    min-height: 10;
    padding: 0;
}

DataTable {
    background: #0d0d0d;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #1a0000;
    color: #ff3333;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2a0000;
    color: #ffffff;
}

DataTable > .datatable--hover {
    background: #150000;
}

#detail_log {
    height: 40%;
    min-height: 8;
}

/* ── VerticalScroll ── */
VerticalScroll {
    height: 1fr;
    overflow-y: auto;
}
